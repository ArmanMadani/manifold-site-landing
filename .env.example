# Choose your email provider: buttondown | mailchimp | sheet | console
# Default is "console" (logs to terminal) so the form works with zero setup in dev.
EMAIL_PROVIDER=console

# --- Buttondown (recommended: you own the list, simple API, generous free tier) ---
# BUTTONDOWN_API_KEY=your_buttondown_api_key

# --- Mailchimp ---
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxx-us21
# MAILCHIMP_LIST_ID=your_audience_id

# --- Google Sheet via Apps Script Web App (or any webhook) ---
# SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfyc.../exec
